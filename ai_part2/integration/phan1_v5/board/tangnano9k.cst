// =============================================================================
// tangnano9k.cst - Gan chan cho kit Sipeed Tang Nano 9K, phien ban tuong lua Ethernet
// Part Number: GW1NR-LV9QN88PC6/I5 (GW1NR-9C)
// Bank 1, 2 chay 3,3 V; bank 3 (nut, LED, chan 79-86) chay 1,8 V - theo so do nguyen ly Sipeed.
// Vi tri chan tren hang chan: xem tai lieu nhom, muc "So do noi day".
// =============================================================================

// Thach anh 27 MHz
IO_LOC  "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Nut bam (nhan = 0), bank 1,8 V: S2 = reset, S1 = doi che do
IO_LOC  "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "key_n" 3;
IO_PORT "key_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// UART ra chip USB-UART tren kit (cong COM tren Laptop trong)
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Cong A (vung ngoai) - hang chan trai
IO_LOC  "a_ref_clk" 35;   // GCLKT_4, clock 50 MHz tu module
IO_PORT "a_ref_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "a_crs_dv"  27;
IO_PORT "a_crs_dv"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "a_rxd[0]"  28;
IO_PORT "a_rxd[0]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "a_rxd[1]"  29;
IO_PORT "a_rxd[1]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "a_tx_en"   30;
IO_PORT "a_tx_en"   IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "a_txd[0]"  33;
IO_PORT "a_txd[0]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "a_txd[1]"  34;
IO_PORT "a_txd[1]"  IO_TYPE=LVCMOS33 DRIVE=8;

// Cong B (vung trong) - hang chan phai
IO_LOC  "b_ref_clk" 63;   // chan thuong, chon canh lay mau bang thu nghiem
IO_PORT "b_ref_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "b_crs_dv"  77;
IO_PORT "b_crs_dv"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "b_rxd[0]"  76;
IO_PORT "b_rxd[0]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "b_rxd[1]"  48;
IO_PORT "b_rxd[1]"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "b_tx_en"   49;
IO_PORT "b_tx_en"   IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "b_txd[0]"  31;
IO_PORT "b_txd[0]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "b_txd[1]"  32;
IO_PORT "b_txd[1]"  IO_TYPE=LVCMOS33 DRIVE=8;

// Man OLED I2C (SSD1306) - chan cu cua ESP32 va coi
// Chi keo xuong 0 hoac tha noi (RTL: assign oled_sda = sda_low ? 1'b0 : 1'bz;)
// Dien tro keo len co san tren module OLED
IO_LOC  "oled_sda"  25;
IO_PORT "oled_sda"  IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "oled_scl"  26;
IO_PORT "oled_scl"  IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 6 LED tren kit (sang khi muc 0), bank 1,8 V: luon tat, chi nhap nhay khi CPU loi
IO_LOC  "led_n[0]" 10;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led_n[1]" 11;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led_n[2]" 13;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led_n[3]" 14;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led_n[4]" 15;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led_n[5]" 16;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
